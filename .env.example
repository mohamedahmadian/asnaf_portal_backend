NODE_ENV=development
PORT=3001

# Shared PostgreSQL database. Use asnaf_portal (created by backend/scripts/create-db-users.sh), not postgres.
DATABASE_URL=postgresql://asnaf_portal:PASSWORD@127.0.0.1:5432/asnaf?schema=public

# Shared storage root used by document storage keys. Use an absolute path.
FILE_STORAGE_DIR=D:/Main projects/qeshm/storage

# Portal-only JWT settings. Never reuse the internal administration secret.
PORTAL_JWT_SECRET=replace-with-at-least-32-random-characters
PORTAL_JWT_AUDIENCE=asnaf-economic-actor-portal
PORTAL_JWT_ISSUER=asnaf-portal-api

# Comma-separated explicit browser origins. Wildcards are rejected.
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
