enum ViolationStatus {
  REGISTERED
  UNDER_REVIEW
  NOTICE
  REFERRED
  VERDICT_ISSUED
  CLOSED
  DISMISSED
}

enum ViolationAttachmentKind {
  IMAGE
  FILE
}

model Violation {
  id              String                 @id @default(uuid())
  nationalId      String
  violationTypeId String
  violationType   ViolationType          @relation(fields: [violationTypeId], references: [id], onDelete: Restrict)
  occurredAt      DateTime               @db.Date
  description     String?
  status          ViolationStatus        @default(REGISTERED)
  caseUserId      String?
  caseUser        User?                  @relation("ViolationCase", fields: [caseUserId], references: [id], onDelete: SetNull)
  caseFileId      String?
  caseFile        CaseFile?              @relation(fields: [caseFileId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User                   @relation("ViolationAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  attachments     ViolationAttachment[]
  proceedings     ViolationProceeding[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([nationalId])
  @@index([violationTypeId])
  @@index([status])
  @@index([caseUserId])
  @@index([caseFileId])
  @@index([occurredAt])
  @@index([createdById])
  @@index([createdAt])
  @@map("violations")
}

model ViolationAttachment {
  id           String                  @id @default(uuid())
  violationId  String
  violation    Violation               @relation(fields: [violationId], references: [id], onDelete: Cascade)
  kind         ViolationAttachmentKind
  imageId      String?
  image        StoredImage?            @relation("ViolationAttachmentImage", fields: [imageId], references: [id], onDelete: Restrict)
  fileId       String?
  file         StoredFile?             @relation("ViolationAttachmentFile", fields: [fileId], references: [id], onDelete: Restrict)
  originalName String?
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())

  @@index([violationId, sortOrder])
  @@index([imageId])
  @@index([fileId])
  @@map("violation_attachments")
}

model ViolationProceeding {
  id           String                          @id @default(uuid())
  violationId  String
  violation    Violation                       @relation(fields: [violationId], references: [id], onDelete: Cascade)
  occurredAt   DateTime                        @db.Date
  title        String
  description  String?
  createdById  String
  createdBy    User                            @relation("ViolationProceedingAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  attachments  ViolationProceedingAttachment[]
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt

  @@index([violationId, occurredAt])
  @@index([title])
  @@index([createdById])
  @@index([createdAt])
  @@map("violation_proceedings")
}

model ViolationProceedingAttachment {
  id           String                  @id @default(uuid())
  proceedingId String
  proceeding   ViolationProceeding     @relation(fields: [proceedingId], references: [id], onDelete: Cascade)
  kind         ViolationAttachmentKind
  imageId      String?
  image        StoredImage?            @relation("ViolationProceedingAttachmentImage", fields: [imageId], references: [id], onDelete: Restrict)
  fileId       String?
  file         StoredFile?             @relation("ViolationProceedingAttachmentFile", fields: [fileId], references: [id], onDelete: Restrict)
  originalName String?
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())

  @@index([proceedingId, sortOrder])
  @@index([imageId])
  @@index([fileId])
  @@map("violation_proceeding_attachments")
}

model SmsSettings {
