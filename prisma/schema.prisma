  senderNumber String?
  username     String?
  password     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sms_settings")
}

enum SmsMessageStatus {
  SKIPPED
  SENT
  FAILED
}

enum SmsMessageSource {
  MANUAL
  PASSWORD
  PAYMENT_LINK
  STEWARDSHIP
}

/// هر دستور ارسال پیامک؛ ارسال واقعی هنوز وصل نیست.
model SmsMessage {
  id           String           @id @default(uuid())
  phone        String
  body         String
  status       SmsMessageStatus
  source       SmsMessageSource @default(MANUAL)
  errorMessage String?
  createdAt    DateTime         @default(now())

  @@index([createdAt])
  @@index([phone])
  @@index([status])
  @@index([source])
  @@map("sms_messages")
}

enum ScheduledJobTrigger {
  SYSTEM
  MANUAL
}

enum ScheduledJobRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

/// تعریف پایدار کارهای زمان‌بندی؛ متادیتای نمایشی در رجیستری کد است.
model ScheduledJob {
  code        String                 @id
  enabled     Boolean                @default(true)
  lastRunAt   DateTime?
  lastStatus  ScheduledJobRunStatus?
  lastMessage String?
  runs        ScheduledJobRun[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("scheduled_jobs")
}

model ScheduledJobRun {
  id            String                @id @default(uuid())
  jobCode       String
  job           ScheduledJob          @relation(fields: [jobCode], references: [code], onDelete: Cascade)
  trigger       ScheduledJobTrigger
  status        ScheduledJobRunStatus
  startedAt     DateTime              @default(now())
  finishedAt    DateTime?
  message       String?
  detail        Json?
  triggeredById String?
  triggeredBy   User?                 @relation("ScheduledJobRunner", fields: [triggeredById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([jobCode, startedAt])
  @@index([status])
  @@index([triggeredById])
  @@map("scheduled_job_runs")
}
