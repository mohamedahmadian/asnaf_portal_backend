generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserGender {
  MALE
  FEMALE
}

enum PersonType {
  NATURAL
  LEGAL
}

enum DocumentGender {
  MALE
  FEMALE
  BOTH
}

enum ResidencyStatus {
  RESIDENT
  NON_RESIDENT
}

enum EducationLevel {
  ILLITERATE
  ELEMENTARY
  MIDDLE_SCHOOL
  DIPLOMA
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  SEMINARY
  OTHER
}

enum DocumentSource {
  MANUAL
  CITIZEN_SYSTEM
  CIVIL_REGISTRY
}

enum PreviousOccupation {
  OTHER
  ACTIVE_MILITARY
  RETIRED_MILITARY
  ACTIVE_EMPLOYEE
  RETIRED_EMPLOYEE
}

enum PremiseEstablishment {
  INDEPENDENT
  COMMERCIAL_COMPLEX
  RESIDENTIAL_COMPLEX
}

enum PremiseGeoPosition {
  MAIN_FRONTAGE
  SIDE_FRONTAGE
  ALLEY
}

enum PremisePublicAccess {
  MEN
  WOMEN
  PUBLIC
  SEPARATE
}

enum PremiseOwnership {
  OWNED
  RENTED
}

enum Religion {
  ISLAM
  CHRISTIANITY
  JUDAISM
  ZOROASTRIANISM
  OTHER
}

enum LocationSource {
  MANUAL
  APP
  STATION
}

enum ProjectImportance {
  VERY_HIGH
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  SUSPENDED
  COMPLETED
}

enum FoodReservationStatus {
  PENDING
  CONFIRMED
}

enum VehicleType {
  SEDAN
  PICKUP
  TRUCK
  MINIBUS
  MOTORCYCLE
  OTHER
}

enum VehicleStatus {
  ACTIVE
  IN_REPAIR
  SCRAPPED
  TRANSFERRED
  MISSING
}

enum VehicleAssignmentType {
  UNIT
  PERSON
}

enum VehicleAssignmentStatus {
  LENT
  RETURNED
}

enum ProjectProgressProcessingMode {
  IMMEDIATE
  DEFERRED
}

enum ProjectProgressTranscriptionStatus {
  NONE
  PENDING
  PROCESSING
  READY
  FAILED
}

model StoredImage {
  id           String   @id @default(uuid())
  mimeType     String
  data         Bytes
  byteSize     Int
  width        Int?
  height       Int?
  originalName String?
  photoUsers             User[] @relation("UserPhoto")
  foodPhotos             Food[] @relation("FoodPhoto")
  restaurantLogos        Restaurant[] @relation("RestaurantLogo")
  progressImages         ProjectProgressImage[]
  singardAttachments     SingardAttachment[]
  boardAttachments       BoardAttachment[]
  boardMinutesAttachments BoardMinutesAttachment[]
  violationAttachments    ViolationAttachment[] @relation("ViolationAttachmentImage")
  violationProceedingAttachments ViolationProceedingAttachment[] @relation("ViolationProceedingAttachmentImage")
  letterheadLogos        CaseLetterhead[] @relation("LetterheadLogo")
  letterheadSignatures   CaseLetterhead[] @relation("LetterheadSignature")
  activityLicenseSignatures CaseActivityLicenseSettings[] @relation("ActivityLicenseSignature")
  paymentReceipts        PaymentReceipt[] @relation("PaymentReceiptImage")
  createdAt              DateTime @default(now())

  @@map("stored_images")
}

model Country {
  id        String     @id @default(uuid())
  iso2      String     @unique
  iso3      String?    @unique
  phoneCode String?
  nameFa    String
  nameEn    String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  provinces Province[]
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive, sortOrder])
  @@map("countries")
}

model Province {
  id                String                @id @default(uuid())
  countryId         String
  country           Country               @relation(fields: [countryId], references: [id], onDelete: Restrict)
  code              String
  nameFa            String
  nameEn            String
  neshanAddress     String?
  latitude          Decimal?              @db.Decimal(10, 7)
  longitude         Decimal?              @db.Decimal(10, 7)
  hasRailway        Boolean               @default(false)
  hasAirport        Boolean               @default(false)
  isActive          Boolean               @default(true)
  sortOrder         Int                   @default(0)
  cities            City[]
  users             User[]                @relation("UserHomeProvince")
  locatedUsers      User[]                @relation("UserLocationProvince")
  locationHistories UserLocationHistory[] @relation("UserLocationHistoryProvince")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([countryId, code])
  @@index([countryId, isActive, sortOrder])
  @@map("provinces")
}

model City {
  id                 String                @id @default(uuid())
  provinceId         String
  province           Province              @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  code               String
  nameFa             String
  nameEn             String
  neshanAddress      String?
  latitude           Decimal?              @db.Decimal(10, 7)
  longitude          Decimal?              @db.Decimal(10, 7)
  isProvinceCapital  Boolean               @default(false)
  hasRailway         Boolean               @default(false)
  hasAirport         Boolean               @default(false)
  isActive           Boolean               @default(true)
  sortOrder          Int                   @default(0)
  users              User[]                @relation("UserHomeCity")
  locatedUsers       User[]                @relation("UserLocationCity")
  premiseCases       CaseFile[]            @relation("CasePremiseCity")
  locationDrafts     CaseLocationDraft[]   @relation("LocationDraftCity")
  premiseHistories   CasePremiseHistory[]  @relation("PremiseHistoryCity")
  locationHistories  UserLocationHistory[] @relation("UserLocationHistoryCity")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([provinceId, code])
  @@index([provinceId, isActive, sortOrder])
  @@map("cities")
}

model BankAccount {
  id            String         @id @default(uuid())
  bankName      String
  accountNumber String
  cardNumber    String?        @unique
  iban          String?        @unique
  paymentId     String?        @unique
  description   String?
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  municipalFees MunicipalFee[]
  financialRequestSettings FinancialRequestSetting[]
  caseRequestFinances CaseRequestFinance[]
  paymentGroups PaymentGroup[]
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([bankName, accountNumber])
  @@index([bankName])
  @@index([accountNumber])
  @@index([paymentId])
  @@index([isActive])
  @@index([createdAt])
  @@map("bank_accounts")
}

model MunicipalFee {
  id            String            @id @default(uuid())
  title         String            @unique
  bankAccountId String
  bankAccount       BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  paymentGroupItems PaymentGroupItem[]
  paymentLines      PaymentLine[]
  caseRequestFees   CaseRequestFee[]
  description       String?
  isActive      Boolean           @default(true)
  amount        Decimal           @db.Decimal(18, 0)
  processTypes  CaseRequestType[] @default([])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([bankAccountId])
  @@index([title])
  @@index([amount])
  @@index([isActive])
  @@index([createdAt])
  @@map("municipal_fees")
}

model FinancialRequestSetting {
  requestType   CaseRequestType @id
  bankAccountId String
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  updatedAt     DateTime        @updatedAt

  @@index([bankAccountId])
  @@map("financial_request_settings")
}

model Discount {
  id           String            @id @default(uuid())
  year         Int
  title        String
  percent      Decimal           @db.Decimal(5, 2)
  processTypes CaseRequestType[] @default([])
  /// اگر روشن باشد این تخفیف روی همهٔ انواع درخواست، از جمله انواعی که بعداً اضافه می‌شوند، دیده می‌شود
  appliesToAllRequests Boolean   @default(false)
  description  String?
  isActive     Boolean           @default(true)
  payments     Payment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([year, title])
  @@index([year])
  @@index([title])
  @@index([isActive])
  @@index([appliesToAllRequests])
  @@index([createdAt])
  @@map("discounts")
}

enum PaymentDiscountMode {
  MANUAL
  CATALOG
}

/// دستهٔ هزینه‌های یک حساب برای ثبت سریع پرداخت
model PaymentGroup {
  id            String             @id @default(uuid())
  title         String
  bankAccountId String
  bankAccount   BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  isDefault     Boolean            @default(false)
  items         PaymentGroupItem[]
  payments      Payment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([bankAccountId])
  @@index([title])
  @@index([createdAt])
  @@map("payment_groups")
}

model PaymentGroupItem {
  id             String        @id @default(uuid())
  paymentGroupId String
  paymentGroup   PaymentGroup  @relation(fields: [paymentGroupId], references: [id], onDelete: Cascade)
  municipalFeeId String
  municipalFee   MunicipalFee  @relation(fields: [municipalFeeId], references: [id], onDelete: Restrict)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())

  @@unique([paymentGroupId, municipalFeeId])
  @@index([municipalFeeId])
  @@index([sortOrder])
  @@map("payment_group_items")
}

/// یک پرداخت ثبت‌شده روی پرونده، با تصویر مبلغ‌ها در همان لحظه
model Payment {
  id                 String              @id @default(uuid())
  caseFileId         String?
  caseFile           CaseFile?           @relation(fields: [caseFileId], references: [id], onDelete: Restrict)
  payerUserId        String
  payer              User                @relation("PaymentPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  personType         PersonType          @default(NATURAL)
  nationalId         String?
  companyName        String?
  companyNationalId  String?
  companyRegistrationNo String?
  payerName          String
  recordedById       String
  recordedBy         User                @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  description        String?
  paymentGroupId     String?
  paymentGroup       PaymentGroup?       @relation(fields: [paymentGroupId], references: [id], onDelete: SetNull)
  paymentGroupTitle  String?
  bankAccountId      String
  bankAccount        BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  discountMode       PaymentDiscountMode
  discountId         String?
  discount           Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountTitle      String?
  discountPercent    Decimal?            @db.Decimal(5, 2)
  feeCount           Int
  subtotal           Decimal             @db.Decimal(18, 0)
  discountAmount     Decimal             @db.Decimal(18, 0)
  finalAmount        Decimal             @db.Decimal(18, 0)
  method             PaymentMethod
  status             PaymentStatus       @default(PAID)
  /// مرجع بانکی: RRN کارت‌خوان، شمارهٔ فیش یا SaleReferenceId درگاه
  trackingCode       String?
  receiptNumber      String              @unique
  caseRequestId      String?
  caseRequest        CaseRequest?        @relation(fields: [caseRequestId], references: [id], onDelete: SetNull)
  /// برای پرداخت آنلاین با تأیید درگاه به‌روز می‌شود
  paidAt             DateTime            @default(now())
  payLinkToken       String?             @unique
  payLinkExpiresAt   DateTime?
  payLinkSentAt      DateTime?
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?               @relation("PaymentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  deleteReason       String?
  lines              PaymentLine[]
  receipts           PaymentReceipt[]
  gatewayTransactions PaymentGatewayTransaction[]
  createdAt          DateTime            @default(now())

  @@index([method])
  @@index([status])
  @@index([trackingCode])
  @@index([caseRequestId])
  @@index([deletedAt])
  @@index([caseFileId])
  @@index([payerUserId])
  @@index([personType])
  @@index([nationalId])
  @@index([companyNationalId])
  @@index([recordedById])
  @@index([paymentGroupId])
  @@index([bankAccountId])
  @@index([discountId])
  @@index([paidAt])
  @@index([finalAmount])
  @@index([subtotal])
  @@index([feeCount])
  @@index([createdAt])
  @@map("payments")
}

model PaymentLine {
  id             String        @id @default(uuid())
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  municipalFeeId String?
  municipalFee   MunicipalFee? @relation(fields: [municipalFeeId], references: [id], onDelete: SetNull)
  title          String
  amount         Decimal       @db.Decimal(18, 0)
  sortOrder      Int           @default(0)

  @@index([paymentId])
  @@index([municipalFeeId])
  @@index([sortOrder])
  @@map("payment_lines")
}

model PaymentReceipt {
  id           String      @id @default(uuid())
  paymentId    String
  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  imageId      String
  image        StoredImage @relation("PaymentReceiptImage", fields: [imageId], references: [id], onDelete: Restrict)
  originalName String?
  uploadedById String
  uploadedBy   User        @relation("PaymentReceiptUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())

  @@index([paymentId, createdAt])
  @@index([imageId])
  @@index([uploadedById])
  @@map("payment_receipts")
}

enum PaymentMethod {
  ONLINE
  POS
  BANK_RECEIPT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentGatewayChannel {
  OPERATOR
  PUBLIC_LINK
}

enum PaymentGatewayStatus {
  INITIATED
  VERIFIED
  SETTLED
  FAILED
  REVERSED
}

model PaymentGatewayTransaction {
  id              String                @id @default(uuid())
  paymentId       String
  payment         Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  gateway         String
  channel         PaymentGatewayChannel
  orderId         BigInt                @unique
  amount          Decimal               @db.Decimal(18, 0)
  status          PaymentGatewayStatus  @default(INITIATED)
  refId           String?
  resCode         String?
  saleReferenceId String?
  cardHolderPan   String?
  rawResponse     Json?
  createdAt       DateTime              @default(now())
  verifiedAt      DateTime?
  settledAt       DateTime?

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@index([refId])
  @@map("payment_gateway_transactions")
}

model JobType {
  id          String   @id @default(uuid())
  title       String   @unique
  description String?
  /// عوارض سالیانه؛ برای شغل‌هایی که عوارض جداگانه ندارند در محاسبه استفاده می‌شود
  annualFee   Decimal? @db.Decimal(18, 0)
  jobs        Job[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([annualFee])
  @@index([createdAt])
  @@map("job_types")
}

model InquiryCenter {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  phone       String?
  officerId   String?
  officer     User?    @relation("InquiryCenterOfficer", fields: [officerId], references: [id], onDelete: SetNull)
  letterTitle String?
  letterBody  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        JobInquiryCenter[]
  caseInquiries CaseInquiry[]
  requirements InquiryRequirement[]
  revocationOrganizations CaseRevocationOrganization[]

  @@index([name])
  @@index([phone])
  @@index([officerId])
  @@index([isActive])
  @@index([createdAt])
  @@map("inquiry_centers")
}

model JobGroup {
  id          String   @id @default(uuid())
  title       String   @unique
  titleEn     String?  @unique
  description String?
  code        String?  @unique
  isActive    Boolean  @default(true)
  jobs        Job[]
  representatives JobGroupRepresentative[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([titleEn])
  @@index([code])
  @@index([isActive])
  @@index([createdAt])
  @@map("job_groups")
}

/// نمایندهٔ یک گروه شغلی؛ همان کاربر با نقش نماینده گروه وارد سامانه می‌شود
model JobGroupRepresentative {
  jobGroupId String
  jobGroup   JobGroup @relation(fields: [jobGroupId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([jobGroupId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("job_group_representatives")
}

model Job {
  id          String             @id @default(uuid())
  /// گروه شغلی؛ خالی یعنی شغل به گروهی وصل نیست
  groupId     String?
  group       JobGroup?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  title       String
  titleEn     String?
  taxIntaCode String?  @unique
  description String?
  code        String
  jobTypeId   String
  jobType     JobType            @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)
  /// عوارض شغل؛ پیش‌فرض از نوع فعالیت می‌آید و جداگانه قابل ویرایش است
  annualFee   Decimal? @db.Decimal(18, 0)
  isActive    Boolean            @default(true)
  inquiryCenters JobInquiryCenter[]
  documents   JobDocument[]
  documentRequirements DocumentRequirement[]
  inquiryRequirements InquiryRequirement[]
  identityUsers User[] @relation("UserEconomicJob")
  activityCases CaseFile[] @relation("CaseActivityJob")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([groupId, code])
  @@unique([groupId, title])
  @@unique([groupId, titleEn])
  @@index([groupId])
  @@index([jobTypeId])
  @@index([annualFee])
  @@index([title])
  @@index([titleEn])
  @@index([isActive])
  @@index([createdAt])
  @@map("jobs")
}

model JobInquiryCenter {
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inquiryCenterId String
  inquiryCenter   InquiryCenter @relation(fields: [inquiryCenterId], references: [id], onDelete: Cascade)

  @@id([jobId, inquiryCenterId])
  @@index([inquiryCenterId])
  @@map("job_inquiry_centers")
}

enum CaseInquiryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CaseInquiryChannel {
  MANUAL
  SYSTEM
}

model CaseInquiry {
  id              String              @id @default(uuid())
  caseFileId      String
  caseFile        CaseFile            @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  caseRequestId   String
  caseRequest     CaseRequest         @relation(fields: [caseRequestId], references: [id], onDelete: Cascade)
  inquiryCenterId String
  inquiryCenter   InquiryCenter       @relation(fields: [inquiryCenterId], references: [id], onDelete: Restrict)
  status          CaseInquiryStatus   @default(PENDING)
  channel         CaseInquiryChannel?
  note            String?
  decidedById     String?
  decidedBy       User?               @relation("CaseInquiryDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  /// زمان ارجاع همین استعلام به مرکز. خالی یعنی پرونده هنوز به مرحلهٔ استعلام نرسیده است.
  referredAt      DateTime?
  /// شمارهٔ نامه؛ با اولین مشاهده یا چاپ ثابت می‌ماند.
  letterNo        String?             @unique
  issuedAt        DateTime?
  files           CaseInquiryFile[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([caseRequestId, inquiryCenterId])
  @@index([caseFileId])
  @@index([caseRequestId])
  @@index([inquiryCenterId])
  @@index([status])
  @@index([decidedById])
  @@index([createdAt])
  @@index([referredAt])
  @@index([status, referredAt])
  @@map("case_inquiries")
}

model CaseInquiryFile {
  id            String      @id @default(uuid())
  caseInquiryId String
  caseInquiry   CaseInquiry @relation(fields: [caseInquiryId], references: [id], onDelete: Cascade)
  storageKey    String
  originalName  String?
  mimeType      String
  byteSize      Int
  uploadedById  String?
  uploadedBy    User?       @relation("CaseInquiryFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([caseInquiryId])
  @@index([uploadedById])
  @@map("case_inquiry_files")
}

/// تنظیمات کلی پرونده‌ها؛ یک ردیف ثابت
model CaseGeneralSettings {
  id                String   @id @default("default")
  editAfterIssuance Boolean  @default(false)
  editorRoleId      String?
  editorRole        Role?    @relation(fields: [editorRoleId], references: [id], onDelete: SetNull)
  /// مدت قرارداد مجوز؛ ۱ تا ۵ سال
  contractYears        Int      @default(1)
  /// مدت اعتبار کارت مباشرت؛ ۱ تا ۵ سال
  stewardContractYears Int      @default(1)
  /// مهلت پاسخ هر مرکز استعلام، به روز. استعلام بی‌پاسخ بعد از این مدت معوق است.
  inquiryResponseDays  Int      @default(5)
  updatedAt         DateTime @updatedAt

  @@index([editorRoleId])
  @@map("case_general_settings")
}

/// سربرگ ثابت نامه‌های استعلام و اماکن
model CaseLetterhead {
  id               String       @id @default("default")
  organizationName String?
  address          String?
  phone            String?
  website          String?
  signerName       String?
  signerTitle      String?
  logoId           String?      @unique
  logo             StoredImage? @relation("LetterheadLogo", fields: [logoId], references: [id], onDelete: SetNull)
  signatureId      String?      @unique
  signature        StoredImage? @relation("LetterheadSignature", fields: [signatureId], references: [id], onDelete: SetNull)
  /// شمارهٔ بعدی نامه. با هر صدور یک واحد زیاد می‌شود.
  nextNumber       Int          @default(1)
  /// متن پیش‌فرض نامه استعلام برای مراکزی که متن جدا ندارند؛ برای همه مشاغل یکسان است.
  defaultLetterBody String?
  /// اندازه پیش‌فرض چاپ نامه: A4 یا A5
  defaultPaper      String   @default("A4")
  updatedAt        DateTime @updatedAt

  @@map("case_letterheads")
}

/// امضای ثابت مجوز فعالیت اقتصادی؛ یک ردیف
model CaseActivityLicenseSettings {
  id          String       @id @default("default")
  signerName  String?
  signerTitle String?
  signatureId String?      @unique
  signature   StoredImage? @relation("ActivityLicenseSignature", fields: [signatureId], references: [id], onDelete: SetNull)
  updatedAt   DateTime     @updatedAt

  @@map("case_activity_license_settings")
}

/// تنظیمات ثابت اداره اماکن؛ یک مسئول برای اعلام نظر روی پرونده‌ها
model CasePlacesOffice {
  id            String   @id @default("default")
  phone         String?
  officerRoleId String?  @unique
  officerRole   Role?    @relation(fields: [officerRoleId], references: [id], onDelete: SetNull)
  letterTitle   String?
  letterBody    String?
  /// مهلت پاسخ اداره اماکن، به روز. پروندهٔ بی‌پاسخ بعد از این مدت برای گزارش معوق است.
  responseDays  Int      @default(5)
  updatedAt     DateTime @updatedAt

  @@index([officerRoleId])
  @@map("case_places_office")
}

/// تنظیمات درخواست ابطال مجوز؛ یک ردیف ثابت
model CaseRevocationSettings {
  id            String                       @id @default("default")
  /// مبلغ ثابت ابطال مجوز اقتصادی
  fixedAmount   Decimal?                     @db.Decimal(18, 0)
  updatedAt     DateTime                     @updatedAt
  organizations CaseRevocationOrganization[]

  @@map("case_revocation_settings")
}

/// سازمانی که هنگام ابطال مجوز باید به آن اطلاع داده شود
model CaseRevocationOrganization {
  id              String                 @id @default(uuid())
  settingsId      String                 @default("default")
  settings        CaseRevocationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  inquiryCenterId String
  inquiryCenter   InquiryCenter          @relation(fields: [inquiryCenterId], references: [id], onDelete: Restrict)
  letterTitle     String?
  letterBody      String?
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([settingsId, inquiryCenterId])
  @@index([inquiryCenterId])
  @@index([sortOrder])
  @@map("case_revocation_organizations")
}

model CasePlacesReview {
  id          String              @id @default(uuid())
  caseFileId    String
  caseFile      CaseFile            @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  caseRequestId String              @unique
  caseRequest   CaseRequest         @relation(fields: [caseRequestId], references: [id], onDelete: Cascade)
  status        CaseInquiryStatus   @default(PENDING)
  channel     CaseInquiryChannel?
  note        String?
  decidedById String?
  decidedBy   User?               @relation("CasePlacesDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  /// زمان ورود واقعی پرونده به کارتابل اماکن. خالی یعنی هنوز ارجاع نشده است.
  referredAt  DateTime?
  /// شمارهٔ نامه؛ با اولین مشاهده یا چاپ ثابت می‌ماند.
  letterNo    String?   @unique
  issuedAt    DateTime?
  files       CasePlacesFile[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([caseFileId])
  @@index([status])
  @@index([decidedById])
  @@index([createdAt])
  @@index([referredAt])
  @@index([status, referredAt])
  @@map("case_places_reviews")
}

model CasePlacesFile {
  id           String           @id @default(uuid())
  reviewId     String
  review       CasePlacesReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String?
  mimeType     String
  byteSize     Int
  uploadedById String?
  uploadedBy   User?            @relation("CasePlacesFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([reviewId])
  @@index([uploadedById])
  @@map("case_places_files")
}

model JobDocument {
  jobId      String
  job        Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documentId String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  gender     DocumentGender @default(BOTH)
  isRequired Boolean        @default(true)

  @@id([jobId, documentId])
  @@index([documentId])
  @@map("job_documents")
}

model Document {
  id         String          @id @default(uuid())
  title      String          @unique
  /// کد پایدار مدرک سیستمی؛ اگر پر باشد حذف و تغییر کد ممنوع است
  code       String?         @unique
  jobs       JobDocument[]
  requirements DocumentRequirement[]
  personDocuments PersonDocument[]
  caseActivityDocuments CaseActivityDocument[]
  caseIdentityDocument CaseIdentityDocument?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([title])
  @@index([createdAt])
  @@index([code])
  @@map("documents")
}

/// مدارکی که در تب مدارک مرحلهٔ اطلاعات هویتی تشکیل پرونده نشان داده می‌شوند
model CaseIdentityDocument {
  documentId String         @id
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  gender     DocumentGender @default(BOTH)
  isRequired Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([gender])
  @@index([isRequired])
  @@map("case_identity_documents")
}

/// واحد و نقشی که در مرحلهٔ تاییدهای مدیریتی باید پرونده را تایید کنند
model CaseManagementApprover {
  id         String   @id @default(uuid())
  workUnitId String
  workUnit   WorkUnit @relation(fields: [workUnitId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workUnitId, roleId])
  @@index([workUnitId])
  @@index([roleId])
  @@index([createdAt])
  @@map("case_management_approvers")
}

/// نقش‌هایی که در تاییدیه مدیریتی هر نوع درخواست دیده می‌شوند، با عنوان نمایشی.
model CaseProcessManagementRole {
  id          String          @id @default(uuid())
  requestType CaseRequestType
  roleId      String
  role        Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  title       String
  createdAt   DateTime        @default(now())

  @@unique([requestType, roleId])
  @@index([requestType])
  @@index([roleId])
  @@index([createdAt])
  @@map("case_process_management_roles")
}

/// نتیجهٔ تایید مدیریتی هر پرونده برای یک واحد و نقش
model CaseManagementReview {
  id          String              @id @default(uuid())
  caseFileId    String
  caseFile      CaseFile            @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  caseRequestId String
  caseRequest   CaseRequest         @relation(fields: [caseRequestId], references: [id], onDelete: Cascade)
  workUnitId    String?
  workUnit      WorkUnit?           @relation(fields: [workUnitId], references: [id], onDelete: Restrict)
  roleId        String
  role        Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status      CaseInquiryStatus   @default(PENDING)
  channel     CaseInquiryChannel?
  note        String?
  decidedById String?
  decidedBy   User?               @relation("CaseManagementDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  files       CaseManagementReviewFile[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([caseRequestId, roleId])
  @@index([caseFileId])
  @@index([caseRequestId])
  @@index([workUnitId])
  @@index([roleId])
  @@index([status])
  @@index([decidedById])
  @@index([createdAt])
  @@map("case_management_reviews")
}

model CaseManagementReviewFile {
  id           String               @id @default(uuid())
  reviewId     String
  review       CaseManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String?
  mimeType     String
  byteSize     Int
  uploadedById String?
  uploadedBy   User?                @relation("CaseManagementFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([reviewId])
  @@index([uploadedById])
  @@map("case_management_review_files")
}

enum CaseRequestType {
  ISSUANCE
  RENEWAL
  LOCATION_CHANGE
  STEWARDSHIP
  AUCTION
}

enum CaseRequestStatus {
  OPEN
  ISSUED
  COMPLETED
  REJECTED
  CANCELLED
}

/// وضعیت ذخیره‌شدهٔ پرونده با اولویت ابطال > تعلیق > انقضا > فعال.
/// فقط `syncCaseStatus` (رویدادها) و جاب شبانهٔ `CaseStatusService` آن را محاسبه می‌کنند؛ ابطال با فعال‌سازی مجدد برداشته می‌شود.
/// کارت مباشرت با انقضای مجوز میزبان هم منقضی می‌شود.
enum CaseFileStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum CaseFileKind {
  LICENSE
  STEWARDSHIP
}

/// کسی که ابطال کارت مباشرت را درخواست کرده است
enum CaseRevokeSource {
  HOST
  STEWARD
  LICENSE
}

/// یک پروندهٔ فعالیت اقتصادی برای یک شخص و یک شغل. شخص می‌تواند چند پرونده داشته باشد.
model CaseFile {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                 CaseFileKind           @default(LICENSE)
  /// پروندهٔ مجوز میزبان؛ فقط برای مباشرت
  hostCaseFileId       String?
  hostCaseFile         CaseFile?              @relation("StewardHost", fields: [hostCaseFileId], references: [id], onDelete: Restrict)
  stewardCases         CaseFile[]             @relation("StewardHost")
  status               CaseFileStatus         @default(ACTIVE)
  revokeReason         String?
  revokeSource         CaseRevokeSource?
  /// لحظهٔ ثبت درخواست ابطال مباشرت
  revokeRequestedAt    DateTime?
  revokedAt            DateTime?
  reactivatedAt        DateTime?
  revokedById          String?
  revokedBy            User?                  @relation("CaseRevocationAuthor", fields: [revokedById], references: [id], onDelete: SetNull)
  /// شمارهٔ کارت مباشرت؛ جدا از شمارهٔ مجوز فعالیت اقتصادی
  cardNumber           String?                @unique
  cardIssuedAt         DateTime?              @db.Date
  cardExpiresAt        DateTime?              @db.Date
  /// مرحلهٔ درخواست صدور: ۰ هویت، ۱ فعالیت، ۲ محل، ۳ استعلام، ۴ اماکن، ۵ بررسی مدیریت، ۶ صدور
  formationStep        Int                    @default(0)
  trackingCode         String?                @unique
  /// شمارهٔ ثابت مجوز فعالیت اقتصادی؛ با تمام شدن درخواست صدور پر می‌شود
  licenseNumber        String?                @unique
  licenseIssuedAt      DateTime?              @db.Date
  licenseExpiresAt     DateTime?              @db.Date
  businessUnitTitle    String?
  activityJobId        String?
  activityJob          Job?                   @relation("CaseActivityJob", fields: [activityJobId], references: [id], onDelete: SetNull)
  previousOccupation   PreviousOccupation?
  posDeviceCount       Int?
  premiseCityId        String?
  premiseCity          City?                  @relation("CasePremiseCity", fields: [premiseCityId], references: [id], onDelete: SetNull)
  premiseEstablishment PremiseEstablishment?
  premiseComplexId     String?
  premiseComplex       CommercialComplex?     @relation("CasePremiseComplex", fields: [premiseComplexId], references: [id], onDelete: SetNull)
  premiseAddress       String?
  premiseAddressEn     String?
  premisePlaque        String?
  premisePlaqueSeries  String?
  premiseFloor         String?
  premiseUnitNo        String?
  premisePostalCode    String?
  premisePhone         String?
  premiseFax           String?
  premiseGeoPosition   PremiseGeoPosition?
  premisePublicAccess  PremisePublicAccess?
  registrationPlaceId  String?
  registrationPlace    RegistrationPlace?     @relation("CaseRegistrationPlace", fields: [registrationPlaceId], references: [id], onDelete: SetNull)
  premiseOwnership     PremiseOwnership?
  premiseDeedNo        String?
  premiseArea          Decimal?               @db.Decimal(12, 2)
  leaseIssuedAt        DateTime?              @db.Date
  leaseExpiresAt       DateTime?              @db.Date
  leaseAgency          String?
  premiseOwnerName     String?
  inquiries            CaseInquiry[]
  placesReviews        CasePlacesReview[]
  managementReviews    CaseManagementReview[]
  requests             CaseRequest[]
  activityDocuments    CaseActivityDocument[]
  premiseHistory       CasePremiseHistory[]
  violations           Violation[]
  suspensions          CaseSuspension[]
  stewardRevokeFile    CaseStewardRevokeFile?
  revocationProcess    CaseRevocationProcess?
  payments             Payment[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([userId])
  @@index([kind])
  @@index([hostCaseFileId])
  @@index([status])
  @@index([revokedById])
  @@index([formationStep])
  @@index([activityJobId])
  @@index([premiseCityId])
  @@index([premiseComplexId])
  @@index([registrationPlaceId])
  @@index([licenseIssuedAt])
  @@index([licenseExpiresAt])
  @@index([createdAt])
  @@map("case_files")
}

/// پیوست درخواست ابطال کارت مباشرت. خود فایل در File Storage است.
model CaseStewardRevokeFile {
  id           String   @id @default(uuid())
  caseFileId   String   @unique
  caseFile     CaseFile @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String?
  mimeType     String
  byteSize     Int
  createdAt    DateTime @default(now())

  @@map("case_steward_revoke_files")
}

/// فرایند سه‌مرحله‌ای ابطال مجوز اقتصادی
model CaseRevocationProcess {
  id               String                 @id @default(uuid())
  caseFileId       String                 @unique
  caseFile         CaseFile               @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  amount           Decimal                @db.Decimal(18, 0)
  revocationDate   DateTime?              @db.Date
  letters          CaseRevocationLetter[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([createdAt])
  @@map("case_revocation_processes")
}

/// نسخهٔ ثابت نامهٔ هر سازمان برای یک فرایند ابطال
model CaseRevocationLetter {
  id               String                 @id @default(uuid())
  processId        String
  process          CaseRevocationProcess  @relation(fields: [processId], references: [id], onDelete: Cascade)
  inquiryCenterId  String
  centerName       String
  centerPhone      String?
  letterTitle      String
  letterBody       String
  letterNo         String?                @unique
  issuedAt         DateTime?              @db.Date
  sortOrder        Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([processId, inquiryCenterId])
  @@index([processId, sortOrder])
  @@map("case_revocation_letters")
}

/// یک دوره تعلیق پرونده. با رفع تعلیق، liftedAt پر می‌شود و پرونده از حالت تعلیق خارج می‌شود.
model CaseSuspension {
  id          String    @id @default(uuid())
  caseFileId  String
  caseFile    CaseFile  @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  reason      String
  startsAt    DateTime  @db.Date
  endsAt      DateTime? @db.Date
  liftNote    String?
  liftedAt    DateTime?
  files       CaseSuspensionFile[]
  createdById String?
  createdBy   User?     @relation("CaseSuspensionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([caseFileId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdById])
  @@index([createdAt])
  @@map("case_suspensions")
}

enum CaseSuspensionFileKind {
  SUSPEND
  LIFT
}

/// پیوست تعلیق یا رفع تعلیق. خود فایل در File Storage است.
model CaseSuspensionFile {
  id           String                 @id @default(uuid())
  suspensionId String
  suspension   CaseSuspension         @relation(fields: [suspensionId], references: [id], onDelete: Cascade)
  kind         CaseSuspensionFileKind
  storageKey   String
  originalName String?
  mimeType     String
  byteSize     Int
  createdAt    DateTime               @default(now())

  @@index([suspensionId])
  @@index([kind])
  @@map("case_suspension_files")
}

/// هر کار روی پرونده: صدور، و بعداً تمدید، مباشرت یا مجوز حراج.
/// شمارهٔ درخواست با باز شدن درخواست زده می‌شود. شمارهٔ مجوز فعالیت اقتصادی روی پرونده ثابت می‌ماند.
model CaseRequest {
  id            String            @id @default(uuid())
  caseFileId    String
  caseFile      CaseFile          @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  type          CaseRequestType
  number        String            @unique
  status        CaseRequestStatus @default(OPEN)
  /// مرحلهٔ همین درخواست. برای صدور همان ۰ تا ۶ است. نوع‌های دیگر مرحلهٔ جدا دارند.
  formationStep Int               @default(0)
  /// ثبت اولیهٔ متقاضی؛ تا تأیید مدیریت، ارجاع استعلام ساخته نمی‌شود.
  intakeSubmittedAt DateTime?
  completedAt   DateTime?
  inquiries     CaseInquiry[]
  placesReview  CasePlacesReview?
  managementReviews CaseManagementReview[]
  activityDocuments CaseActivityDocument[]
  events        CaseRequestEvent[]
  renewalTerms  CaseRenewalTerms?
  locationDraft CaseLocationDraft?
  replacedPremise CasePremiseHistory?
  auction       CaseAuction?
  payments      Payment[]
  finance       CaseRequestFinance?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([caseFileId])
  @@index([type])
  @@index([status])
  @@index([formationStep])
  @@index([createdAt])
  @@map("case_requests")
}

/// حساب و هزینه‌های همین درخواست. با اولین باز شدن از تنظیمات مالی همان نوع درخواست پر می‌شود.
model CaseRequestFinance {
  requestId     String           @id
  request       CaseRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  bankAccountId String
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  fees          CaseRequestFee[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([bankAccountId])
  @@map("case_request_finances")
}

/// مبلغ این هزینه برای همین درخواست؛ با تغییر مبلغ پایهٔ هزینه عوض نمی‌شود
model CaseRequestFee {
  id             String             @id @default(uuid())
  requestId      String
  finance        CaseRequestFinance @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  municipalFeeId String
  municipalFee   MunicipalFee       @relation(fields: [municipalFeeId], references: [id], onDelete: Restrict)
  title          String
  amount         Decimal            @db.Decimal(18, 0)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  @@unique([requestId, municipalFeeId])
  @@index([municipalFeeId])
  @@map("case_request_fees")
}

/// تغییر وضعیت درخواست
model CaseRequestEvent {
  id         String            @id @default(uuid())
  requestId  String
  request    CaseRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus CaseRequestStatus?
  toStatus   CaseRequestStatus
  actorId    String?
  actor      User?             @relation("CaseRequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([requestId])
  @@index([actorId])
  @@index([createdAt])
  @@map("case_request_events")
}

/// تاریخ‌های محاسبه‌شدهٔ تمدید؛ موقع باز شدن درخواست ثابت می‌شوند
model CaseRenewalTerms {
  requestId          String    @id
  request            CaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  currentIssuedAt    DateTime  @db.Date
  currentExpiresAt   DateTime  @db.Date
  nextIssuedAt       DateTime  @db.Date
  nextExpiresAt      DateTime  @db.Date
  /// روزهای گذشته از انقضای فعلی؛ صفر یعنی هنوز نگذشته
  delayDays          Int       @default(0)

  @@index([currentExpiresAt])
  @@map("case_renewal_terms")
}

/// محل پیشنهادی تغییر مکان تا زمان تکمیل درخواست
model CaseLocationDraft {
  requestId            String                 @id
  request              CaseRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  premiseCityId        String?
  premiseCity          City?                  @relation("LocationDraftCity", fields: [premiseCityId], references: [id], onDelete: SetNull)
  premiseEstablishment PremiseEstablishment?
  premiseComplexId     String?
  premiseComplex       CommercialComplex?     @relation("LocationDraftComplex", fields: [premiseComplexId], references: [id], onDelete: SetNull)
  premiseAddress       String?
  premiseAddressEn     String?
  premisePlaque        String?
  premisePlaqueSeries  String?
  premiseFloor         String?
  premiseUnitNo        String?
  premisePostalCode    String?
  premisePhone         String?
  premiseFax           String?
  premiseGeoPosition   PremiseGeoPosition?
  premisePublicAccess  PremisePublicAccess?
  registrationPlaceId  String?
  registrationPlace    RegistrationPlace?     @relation("LocationDraftRegistration", fields: [registrationPlaceId], references: [id], onDelete: SetNull)
  premiseOwnership     PremiseOwnership?
  premiseDeedNo        String?
  premiseArea          Decimal?               @db.Decimal(12, 2)
  leaseIssuedAt        DateTime?              @db.Date
  leaseExpiresAt       DateTime?              @db.Date
  leaseAgency          String?
  premiseOwnerName     String?
  updatedAt            DateTime               @updatedAt

  @@index([premiseCityId])
  @@index([premiseComplexId])
  @@index([registrationPlaceId])
  @@map("case_location_drafts")
}

/// محل قبلی پرونده. قبل از نشستن آدرس جدیدِ تغییر مکان، در همان تراکنش ذخیره می‌شود.
model CasePremiseHistory {
  id                   String                 @id @default(uuid())
  caseFileId           String
  caseFile             CaseFile               @relation(fields: [caseFileId], references: [id], onDelete: Cascade)
  replacedByRequestId  String?                @unique
  replacedByRequest    CaseRequest?           @relation(fields: [replacedByRequestId], references: [id], onDelete: SetNull)
  startedAt            DateTime
  endedAt              DateTime
  premiseCityId        String?
  premiseCity          City?                  @relation("PremiseHistoryCity", fields: [premiseCityId], references: [id], onDelete: SetNull)
  premiseEstablishment PremiseEstablishment?
  premiseComplexId     String?
  premiseComplex       CommercialComplex?     @relation("PremiseHistoryComplex", fields: [premiseComplexId], references: [id], onDelete: SetNull)
  premiseAddress       String?
  premiseAddressEn     String?
  premisePlaque        String?
  premisePlaqueSeries  String?
  premiseFloor         String?
  premiseUnitNo        String?
  premisePostalCode    String?
  premisePhone         String?
  premiseFax           String?
  premiseGeoPosition   PremiseGeoPosition?
  premisePublicAccess  PremisePublicAccess?
  registrationPlaceId  String?
  registrationPlace    RegistrationPlace?     @relation("PremiseHistoryRegistration", fields: [registrationPlaceId], references: [id], onDelete: SetNull)
  premiseOwnership     PremiseOwnership?
  premiseDeedNo        String?
  premiseArea          Decimal?               @db.Decimal(12, 2)
  leaseIssuedAt        DateTime?              @db.Date
  leaseExpiresAt       DateTime?              @db.Date
  leaseAgency          String?
  premiseOwnerName     String?

  @@index([caseFileId, endedAt])
  @@index([premiseCityId])
  @@index([premiseComplexId])
  @@index([registrationPlaceId])
  @@map("case_premise_history")
}

enum AuctionApproverKind {
  SPECIAL_INSPECTOR
  AUCTION_COMMITTEE
  COMMERCIAL_MANAGER
}

/// بازه، سقف تخفیف و کالاهای درخواست مجوز حراج
model CaseAuction {
  requestId   String   @id
  request     CaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  title       String?
  startsAt    DateTime @db.Date
  endsAt      DateTime @db.Date
